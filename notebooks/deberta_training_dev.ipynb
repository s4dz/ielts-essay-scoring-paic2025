   "source": [
    "import os\n",
    "import gc\n",
    "import sys\n",
    "import logging\n",
    "import warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import scipy.optimize as optimized\n",
    "from torch.optim import AdamW\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from transformers import AutoTokenizer, AutoModel, AutoConfig, get_linear_schedule_with_warmup\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from sklearn.metrics import mean_absolute_error\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "# ==========================================\n",
    "# 1. CONFIGURATION\n",
    "# ==========================================\n",
    "os.environ['TF_CPP_MIN_LOG_LEVEL'] = '3'\n",
    "logging.getLogger(\"transformers\").setLevel(logging.ERROR)\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "class Config:\n",
    "    # Paths\n",
    "    TRAIN_FILE = \"/kaggle/input/ieltsdata/public_train.csv\"\n",
    "    TEST_FILE = \"/kaggle/input/ieltsdata/public_test.csv\"\n",
    "    SUBMISSION_FILE = \"submission.csv\"\n",
    "    \n",
    "    # Model: CHANGED TO LARGE\n",
    "    MODEL_NAME = \"microsoft/deberta-v3-large\"\n",
    "    MAX_LEN = 640\n",
    "    \n",
    "    # Training Dynamics\n",
    "    FOLDS = 5                   \n",
    "    # ⚠️ CRITICAL: Reduced Batch Size for Large Model\n",
    "    TRAIN_BATCH_SIZE = 2        \n",
    "    VALID_BATCH_SIZE = 4        \n",
    "    GRAD_ACCUM_STEPS = 6        # Increased to keep effective batch size stable\n",
    "    EPOCHS = 4                  \n",
    "    \n",
    "    # Optimization (LLRD)\n",
    "    LEARNING_RATE = 1e-5        # Slightly lower LR is safer for Large\n",
    "    LLRD_DECAY = 0.9            \n",
    "    WEIGHT_DECAY = 0.01\n",
    "    SEED = 42\n",
    "\n",
    "def seed_everything(seed=42):\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    torch.cuda.manual_seed(seed)\n",
    "    torch.backends.cudnn.deterministic = True\n",
    "\n",
    "seed_everything(Config.SEED)\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "print(f\"🔹 Device: {DEVICE}\")\n",
    "print(f\"🔹 Model: {Config.MODEL_NAME}\")\n",
    "\n",
    "# ==========================================\n",
    "# 2. UTILS\n",
    "# ==========================================\n",
    "def hybrid_criterion(outputs, targets):\n",
    "    logits_ord, logits_reg = outputs\n",
    "    \n",
    "    # 1. Ordinal Loss (BCE)\n",
    "    loss_ord = nn.BCEWithLogitsLoss()(logits_ord, targets)\n",
    "    \n",
    "    # 2. Regression Loss (MSE)\n",
    "    # We must reconstruct the scalar score from the ordinal target vector\n",
    "    # (e.g., [1,1,1,0...] -> 2.5)\n",
    "    true_scores = 1.0 + (targets.sum(dim=1) * 0.5)\n",
    "    \n",
    "    # 0.5 weight is a standard starting point to balance the tasks\n",
    "    loss_reg = nn.MSELoss()(logits_reg.view(-1), true_scores.view(-1))\n",
    "    \n",
    "    return loss_ord + 0.5 * loss_reg\n",
    "class AWP:\n",
    "    \"\"\"\n",
    "    Adversarial Weight Perturbation:\n",
    "    Attacks the model weights to flatten the loss landscape.\n",
    "    \"\"\"\n",
    "    def __init__(self, model, optimizer, adv_param=\"weight\", adv_lr=1, adv_eps=0.001):\n",
    "        self.model = model\n",
    "        self.optimizer = optimizer\n",
    "        self.adv_param = adv_param\n",
    "        self.adv_lr = adv_lr\n",
    "        self.adv_eps = adv_eps\n",
    "        self.backup = {}\n",
    "        self.backup_eps = {}\n",
    "\n",
    "    def attack_backward(self, input_ids, attention_mask, labels, criterion, scaler):\n",
    "        self._save() \n",
    "        self._attack_step() \n",
    "        \n",
    "        # Forward pass with perturbed weights\n",
    "        with torch.cuda.amp.autocast():\n",
    "            logits = self.model(input_ids, attention_mask)\n",
    "            adv_loss = criterion(logits, labels)\n",
    "            \n",
    "        self.optimizer.zero_grad()\n",
    "        scaler.scale(adv_loss).backward()\n",
    "        self._restore()\n",
    "\n",
    "    def _attack_step(self):\n",
    "        e = 1e-6\n",
    "        for name, param in self.model.named_parameters():\n",
    "            if param.requires_grad and param.grad is not None and self.adv_param in name:\n",
    "                norm1 = torch.norm(param.grad)\n",
    "                norm2 = torch.norm(param.data.detach())\n",
    "                if norm1 != 0 and not torch.isnan(norm1):\n",
    "                    r_at = self.adv_lr * param.grad / (norm1 + e) * (norm2 + e)\n",
    "                    self.model.state_dict()[name].add_(r_at)\n",
    "                    self.backup_eps[name] = r_at\n",
    "\n",
    "    def _save(self):\n",
    "        for name, param in self.model.named_parameters():\n",
    "            if param.requires_grad and param.grad is not None and self.adv_param in name:\n",
    "                if name not in self.backup:\n",
    "                    self.backup[name] = param.data.clone()\n",
    "                    self.backup_eps[name] = param.data.clone()\n",
    "\n",
    "    def _restore(self):\n",
    "        for name, param in self.model.named_parameters():\n",
    "            if param.requires_grad and param.grad is not None and self.adv_param in name:\n",
    "                param.data = self.backup[name]\n",
    "        self.backup = {}\n",
    "        self.backup_eps = {}\n",
    "        \n",
    "class OptRounder:\n",
    "    def _init__(self): self.coef = 0\n",
    "    def _loss_func(self, coef, X, y):\n",
    "        X_p = np.array([self._apply_coef(x, coef) for x in X])\n",
    "        return mean_absolute_error(y, X_p)\n",
    "    def _apply_coef(self, x, coef):\n",
    "        if x < coef[0]: return 1.0\n",
    "        for i in range(len(coef)):\n",
    "            if x < coef[i]: return 1.0 + i * 0.5\n",
    "        return 9.0\n",
    "    def fit(self, preds, targets):\n",
    "        initial_coef = [1.25 + i * 0.5 for i in range(16)]\n",
    "        self.coef_ = optimized.minimize(\n",
    "            self._loss_func, initial_coef, args=(preds, targets), \n",
    "            method='Nelder-Mead', options={'maxiter': 500}\n",
    "        ).x\n",
    "    def predict(self, preds):\n",
    "        return np.array([self._apply_coef(x, self.coef_) for x in preds])\n",
    "\n",
    "def get_optimizer_params(model, encoder_lr, decoder_lr, weight_decay=0.0):\n",
    "    no_decay = [\"bias\", \"LayerNorm.bias\", \"LayerNorm.weight\"]\n",
    "    optimizer_parameters = []\n",
    "    \n",
    "    # --- 1. HEAD PARAMS (High LR) ---\n",
    "    # Start with attention pool\n",
    "    head_params = list(model.attention_pool.named_parameters())\n",
    "    \n",
    "    # Add whatever linear heads exist in the model\n",
    "    if hasattr(model, 'fc'):\n",
    "        head_params += list(model.fc.named_parameters())\n",
    "    \n",
    "    # Check for hybrid heads\n",
    "    if hasattr(model, 'fc_ordinal'):\n",
    "        head_params += list(model.fc_ordinal.named_parameters())\n",
    "    if hasattr(model, 'fc_reg'):\n",
    "        head_params += list(model.fc_reg.named_parameters())\n",
    "        \n",
    "    optimizer_parameters.append({\n",
    "        \"params\": [p for n, p in head_params if not any(nd in n for nd in no_decay)],\n",
    "        \"weight_decay\": weight_decay,\n",
    "        \"lr\": decoder_lr,\n",
    "    })\n",
    "    optimizer_parameters.append({\n",
    "        \"params\": [p for n, p in head_params if any(nd in n for nd in no_decay)],\n",
    "        \"weight_decay\": 0.0,\n",
    "        \"lr\": decoder_lr,\n",
    "    })\n",
    "    \n",
    "    # --- 2. BACKBONE PARAMS (Decaying LR) ---\n",
    "    layers = [model.base_model.embeddings] + list(model.base_model.encoder.layer)\n",
    "    layers.reverse() \n",
    "    lr = encoder_lr\n",
    "    for layer in layers:\n",
    "        optimizer_parameters.append({\n",
    "            \"params\": [p for n, p in layer.named_parameters() if not any(nd in n for nd in no_decay)],\n",
    "            \"weight_decay\": weight_decay,\n",
    "            \"lr\": lr,\n",
    "        })\n",
    "        optimizer_parameters.append({\n",
    "            \"params\": [p for n, p in layer.named_parameters() if any(nd in n for nd in no_decay)],\n",
    "            \"weight_decay\": 0.0,\n",
    "            \"lr\": lr,\n",
    "        })\n",
    "        lr *= Config.LLRD_DECAY \n",
    "        \n",
    "    return optimizer_parameters\n",
    "\n",
    "# ==========================================\n",
    "# 3. DATASET\n",
    "# ==========================================\n",
    "class AttentionPooling(nn.Module):\n",
    "    def __init__(self, in_dim):\n",
    "        super().__init__()\n",
    "        self.attention = nn.Sequential(\n",
    "            nn.Linear(in_dim, in_dim),\n",
    "            nn.LayerNorm(in_dim),\n",
    "            nn.GELU(),\n",
    "            nn.Linear(in_dim, 1)\n",
    "        )\n",
    "    def forward(self, last_hidden_state, attention_mask):\n",
    "        w = self.attention(last_hidden_state).float()\n",
    "        w[attention_mask==0] = float('-inf')\n",
    "        w = torch.softmax(w, 1)\n",
    "        return torch.sum(w * last_hidden_state, dim=1)\n",
    "\n",
    "class IELTSOrdinalDataset(Dataset):\n",
    "    def __init__(self, df, tokenizer, is_test=False):\n",
    "        self.df = df\n",
    "        self.tokenizer = tokenizer\n",
    "        self.is_test = is_test\n",
    "    def __len__(self): return len(self.df)\n",
    "    def __getitem__(self, index):\n",
    "        row = self.df.iloc[index]\n",
    "        prompt = str(row['Prompt']).strip()\n",
    "        essay = str(row['Essay']).strip()\n",
    "        img_desc = str(row.get('Image Description', '')).strip()\n",
    "        if img_desc.lower() == 'nan': img_desc = \"\"\n",
    "        \n",
    "        # Format: PROMPT ... [SEP] IMAGE ... [SEP] ESSAY\n",
    "        if img_desc:\n",
    "            full_text = f\"PROMPT: {prompt} {self.tokenizer.sep_token} IMAGE: {img_desc} {self.tokenizer.sep_token} ESSAY: {essay}\"\n",
    "        else:\n",
    "            full_text = f\"PROMPT: {prompt} {self.tokenizer.sep_token} ESSAY: {essay}\"\n",
    "            \n",
    "        inputs = self.tokenizer.encode_plus(\n",
    "            full_text, add_special_tokens=True, truncation=True, \n",
    "            max_length=Config.MAX_LEN, return_attention_mask=True, return_tensors='pt'\n",
    "        )\n",
    "        item = {\n",
    "            'input_ids': inputs['input_ids'].flatten(),\n",
    "            'attention_mask': inputs['attention_mask'].flatten()\n",
    "        }\n",
    "        if not self.is_test:\n",
    "            # Ordinal Targets (16 bins)\n",
    "            score = float(row['Overall'])\n",
    "            target = np.zeros(16, dtype=np.float32)\n",
    "            for i in range(16):\n",
    "                if score > (1.0 + i * 0.5): target[i] = 1.0\n",
    "            item['labels'] = torch.tensor(target, dtype=torch.float)\n",
    "        return item\n",
    "\n",
    "class SmartCollator:\n",
    "    def __init__(self, tokenizer): self.tokenizer = tokenizer\n",
    "    def __call__(self, batch):\n",
    "        input_ids = [item['input_ids'] for item in batch]\n",
    "        batch_inputs = self.tokenizer.pad({'input_ids': input_ids}, padding=True, return_tensors='pt')\n",
    "        item = {\n",
    "            'input_ids': batch_inputs['input_ids'], \n",
    "            'attention_mask': batch_inputs['attention_mask']\n",
    "        }\n",
    "        if 'labels' in batch[0]:\n",
    "            item['labels'] = torch.stack([item['labels'] for item in batch])\n",
    "        return item\n",
    "\n",
    "# ==========================================\n",
    "# 4. MODEL\n",
    "# ==========================================\n",
    "class IELTS_Model_Hybrid(nn.Module):\n",
    "    def __init__(self, model_name):\n",
    "        super().__init__()\n",
    "        self.config = AutoConfig.from_pretrained(model_name)\n",
    "        self.base_model = AutoModel.from_pretrained(model_name, config=self.config)\n",
    "        self.attention_pool = AttentionPooling(self.config.hidden_size)\n",
    "        \n",
    "        # --- HYBRID HEADS ---\n",
    "        self.fc_ordinal = nn.Linear(self.config.hidden_size, 16) # Classification\n",
    "        self.fc_reg = nn.Linear(self.config.hidden_size, 1)      # Regression\n",
    "        \n",
    "        self._init_weights(self.attention_pool)\n",
    "        self._init_weights(self.fc_ordinal)\n",
    "        self._init_weights(self.fc_reg)\n",
    "        \n",
    "    def _init_weights(self, module):\n",
    "        if isinstance(module, nn.Linear):\n",
    "            module.weight.data.normal_(mean=0.0, std=self.config.initializer_range)\n",
    "            if module.bias is not None: module.bias.data.zero_()\n",
    "\n",
    "    def forward(self, input_ids, attention_mask):\n",
    "        outputs = self.base_model(input_ids=input_ids, attention_mask=attention_mask)\n",
    "        embeddings = self.attention_pool(outputs.last_hidden_state, attention_mask)\n",
    "        \n",
    "        # Return Tuple: (Ordinal Logits, Regression Score)\n",
    "        return self.fc_ordinal(embeddings), self.fc_reg(embeddings)\n",
    "\n",
    "# ==========================================\n",
    "# 5. TRAINING LOOP\n",
    "# ==========================================\n",
    "def valid_fn(model, loader, device):\n",
    "    model.eval()\n",
    "    preds, targets = [], []\n",
    "    with torch.no_grad():\n",
    "        for batch in loader:\n",
    "            input_ids = batch['input_ids'].to(device)\n",
    "            mask = batch['attention_mask'].to(device)\n",
    "            \n",
    "            # Unpack Tuple\n",
    "            logits_ord, _ = model(input_ids, mask)\n",
    "            \n",
    "            # Standard Ordinal Decoding\n",
    "            probs = torch.sigmoid(logits_ord)\n",
    "            pred_scores = 1.0 + (probs.sum(dim=1) * 0.5)\n",
    "            \n",
    "            preds.extend(pred_scores.cpu().numpy())\n",
    "            if 'labels' in batch:\n",
    "                labels = batch['labels'].to(device)\n",
    "                true_scores = 1.0 + (labels.sum(dim=1) * 0.5)\n",
    "                targets.extend(true_scores.cpu().numpy())\n",
    "    return np.array(preds), np.array(targets)\n",
    "\n",
    "def train_loop():\n",
    "    if not os.path.exists(Config.TRAIN_FILE): raise FileNotFoundError(f\"Missing: {Config.TRAIN_FILE}\")\n",
    "    \n",
    "    Config.AWP_START_EPOCH = 2\n",
    "    Config.AWP_LR = 1e-4\n",
    "    Config.AWP_EPS = 1e-2\n",
    "\n",
    "    df_train_full = pd.read_csv(Config.TRAIN_FILE)\n",
    "    df_test = pd.read_csv(Config.TEST_FILE)\n",
    "    \n",
    "    for df in [df_train_full, df_test]:\n",
    "        df.columns = df.columns.str.strip()\n",
    "        df.rename(columns={'prompt': 'Prompt', 'essay': 'Essay', 'Overall Score': 'Overall', 'image description': 'Image Description'}, inplace=True)\n",
    "    df_train_full.dropna(subset=['Prompt', 'Essay', 'Overall'], inplace=True)\n",
    "    \n",
    "    skf = StratifiedKFold(n_splits=Config.FOLDS, shuffle=True, random_state=Config.SEED)\n",
    "    y_stratify = df_train_full['Overall'].astype(str)\n",
    "    \n",
    "    tokenizer = AutoTokenizer.from_pretrained(Config.MODEL_NAME)\n",
    "    collator = SmartCollator(tokenizer)\n",
    "    oof_df = pd.DataFrame()\n",
    "    \n",
    "    for fold, (train_idx, val_idx) in enumerate(skf.split(df_train_full, y_stratify)):\n",
    "        print(f\"\\n{'='*10} FOLD {fold+1}/{Config.FOLDS} {'='*10}\")\n",
    "        df_train, df_val = df_train_full.iloc[train_idx].reset_index(drop=True), df_train_full.iloc[val_idx].reset_index(drop=True)\n",
    "        \n",
    "        train_loader = DataLoader(IELTSOrdinalDataset(df_train, tokenizer), batch_size=Config.TRAIN_BATCH_SIZE, shuffle=True, collate_fn=collator)\n",
    "        valid_loader = DataLoader(IELTSOrdinalDataset(df_val, tokenizer), batch_size=Config.VALID_BATCH_SIZE, shuffle=False, collate_fn=collator)\n",
    "        \n",
    "        # 🔥 UPDATED MODEL CLASS\n",
    "        model = IELTS_Model_Hybrid(Config.MODEL_NAME)\n",
    "        if torch.cuda.device_count() > 1: model = nn.DataParallel(model)\n",
    "        model.to(DEVICE)\n",
    "        \n",
    "        optimizer = AdamW(get_optimizer_params(\n",
    "            model.module if hasattr(model, 'module') else model, \n",
    "            Config.LEARNING_RATE, Config.LEARNING_RATE * 5, Config.WEIGHT_DECAY\n",
    "        ))\n",
    "        \n",
    "        awp = AWP(model, optimizer, adv_lr=Config.AWP_LR, adv_eps=Config.AWP_EPS)\n",
    "        \n",
    "        num_steps = len(train_loader) * Config.EPOCHS // Config.GRAD_ACCUM_STEPS\n",
    "        scheduler = get_linear_schedule_with_warmup(optimizer, 0, num_steps)\n",
    "        scaler = torch.cuda.amp.GradScaler()\n",
    "        \n",
    "        best_mae = float('inf')\n",
    "        \n",
    "        for epoch in range(Config.EPOCHS):\n",
    "            model.train()\n",
    "            total_loss = 0\n",
    "            optimizer.zero_grad()\n",
    "            pbar = tqdm(train_loader, desc=f\"Ep {epoch+1}\")\n",
    "            \n",
    "            for step, batch in enumerate(pbar):\n",
    "                input_ids = batch['input_ids'].to(DEVICE)\n",
    "                mask = batch['attention_mask'].to(DEVICE)\n",
    "                labels = batch['labels'].to(DEVICE)\n",
    "                \n",
    "                with torch.cuda.amp.autocast():\n",
    "                    outputs = model(input_ids, mask)\n",
    "                    # 🔥 USE HYBRID LOSS\n",
    "                    loss = hybrid_criterion(outputs, labels) / Config.GRAD_ACCUM_STEPS\n",
    "                \n",
    "                scaler.scale(loss).backward()\n",
    "                \n",
    "                if (step + 1) % Config.GRAD_ACCUM_STEPS == 0:\n",
    "                    if epoch >= Config.AWP_START_EPOCH:\n",
    "                        # 🔥 PASS HYBRID LOSS TO AWP\n",
    "                        awp.attack_backward(input_ids, mask, labels, hybrid_criterion, scaler)\n",
    "                    \n",
    "                    scaler.step(optimizer)\n",
    "                    scaler.update()\n",
    "                    optimizer.zero_grad()\n",
    "                    scheduler.step()\n",
    "                \n",
    "                total_loss += loss.item() * Config.GRAD_ACCUM_STEPS\n",
    "                pbar.set_postfix({'loss': total_loss / (step + 1)})\n",
    "            \n",
    "            val_preds, val_targets = valid_fn(model, valid_loader, DEVICE)\n",
    "            val_mae = mean_absolute_error(val_targets, val_preds)\n",
    "            print(f\"Fold {fold+1} Epoch {epoch+1} | MAE: {val_mae:.4f}\")\n",
    "            \n",
    "            if val_mae < best_mae:\n",
    "                best_mae = val_mae\n",
    "                save_model = model.module if hasattr(model, 'module') else model\n",
    "                torch.save(save_model.state_dict(), f\"model_fold_{fold}.pth\")\n",
    "                print(f\">>> 💾 Saved Best Model! (MAE: {best_mae:.4f})\")\n",
    "        \n",
    "        # Load Best for OOF\n",
    "        model = IELTS_Model_Hybrid(Config.MODEL_NAME)\n",
    "        if torch.cuda.device_count() > 1: model = nn.DataParallel(model) # <--- SOURCE OF ERROR\n",
    "        model.to(DEVICE)\n",
    "        \n",
    "        val_preds, val_targets = valid_fn(model, valid_loader, DEVICE)\n",
    "        df_val['oof_pred'] = val_preds\n",
    "        oof_df = pd.concat([oof_df, df_val])\n",
    "        del model, optimizer, scaler, scheduler, awp; torch.cuda.empty_cache(); gc.collect()\n",
    "\n",
    "    print(\"\\n🔧 Optimizing Thresholds...\")\n",
    "    rounder = OptRounder()\n",
    "    rounder.fit(oof_df['oof_pred'], oof_df['Overall'])\n",
    "    print(f\"Final CV MAE: {mean_absolute_error(oof_df['Overall'], rounder.predict(oof_df['oof_pred'])):.4f}\")\n",
    "    \n",
    "    print(\"\\n🔮 Predicting Test...\")\n",
    "    test_loader = DataLoader(IELTSOrdinalDataset(df_test, tokenizer, is_test=True), batch_size=Config.VALID_BATCH_SIZE, shuffle=False, collate_fn=collator)\n",
    "    \n",
    "    fold_preds = []\n",
    "    for fold in range(Config.FOLDS):\n",
    "        model = IELTS_Model_Hybrid(Config.MODEL_NAME)\n",
    "        model.load_state_dict(torch.load(f\"model_fold_{fold}.pth\"))\n",
    "        model.to(DEVICE)\n",
    "        if torch.cuda.device_count() > 1: model = nn.DataParallel(model)\n",
    "        \n",
    "        raw_preds, _ = valid_fn(model, test_loader, DEVICE)\n",
    "        fold_preds.append(raw_preds)\n",
    "        del model; torch.cuda.empty_cache(); gc.collect()\n",
    "        \n",
    "    avg_preds = np.mean(fold_preds, axis=0)\n",
    "    final_scores = rounder.predict(avg_preds)\n",
    "    \n",
    "    sub = pd.DataFrame({'id': df_test['ID'] if 'ID' in df_test.columns else df_test.index, 'score': final_scores})\n",
    "    sub.to_csv(Config.SUBMISSION_FILE, index=False)\n",
    "    print(\"✅ Done.\")\n",
    "\n",
    "train_loop()"
   ]
  }
 ],
